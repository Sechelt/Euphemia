        </Folder>
        <Folder
            Name="Other Files"
            Filters=""
            GUID="{F3DB100D-2C6E-4F90-884A-D4D0F6D30795}">
            <F N="DR.pro"/>
        </Folder>
    </Files>
    <List Name="RTE">

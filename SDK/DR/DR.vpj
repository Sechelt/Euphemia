            Filters="*.h;*.H;*.hh;*.hpp;*.hxx;*.h++;*.inc;*.sh;*.cpy;*.if"
            GUID="{473171DF-B310-41B6-9345-C4182219A834}">
            <F N="include/DR.h"/>
            <F N="include/DRArc.h"/>
            <F N="include/DRArrow.h"/>
            <F N="include/DRChord.h"/>
            <F N="include/DRDraw.h"/>
            <F N="include/DREllipse.h"/>
            <F N="include/DRGroup.h"/>
            <F N="include/DRImage.h"/>
            <F N="include/DRLine.h"/>
            <F N="include/DRObject.h"/>
            <F N="include/DRPie.h"/>
            <F N="include/DRPolygon.h"/>
            <F N="include/DRPolyline.h"/>
            <F N="include/DRRectangle.h"/>
            <F N="include/DRRectangleBase.h"/>
            <F N="include/DRSelectPolygon.h"/>
            <F N="include/DRSelectRectangle.h"/>
            <F N="include/DRSImage.h"/>
            <F N="include/DRText.h"/>
        </Folder>
        <Folder
            Name="Resource Files"
            Filters="*.ico;*.cur;*.dlg"
            GUID="{4665F1B1-8E88-45AC-9738-D4E5F413D42D}">
            <F N="DR.qrc"/>
        </Folder>
        <Folder
            Name="Bitmaps"
            Filters="*.bmp"
            GUID="{8835C252-58E0-44A4-A6E0-0B476DF7D3B6}">
            <F N="images/Arc.png"/>
            <F N="images/Arrow.png"/>
            <F N="images/Chord.png"/>
            <F N="images/Draw.png"/>
            <F N="images/Ellipse.png"/>

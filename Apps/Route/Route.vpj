            <F N="RouteControlWidget.h"/>
            <F N="RouteScene.h"/>
            <F N="RouteSource.h"/>
            <F N="RouteWidget.h"/>
        </Folder>
        <Folder
            Name="Source Files"
            Filters="*.c;*.C;*.cc;*.cpp;*.cp;*.cxx;*.c++;*.prg;*.pas;*.dpr;*.asm;*.s;*.bas;*.java;*.cs;*.sc;*.scala;*.e;*.cob;*.html;*.rc;*.tcl;*.py;*.pl;*.d;*.m;*.mm;*.go;*.groovy;*.gsh"
            GUID="{8F7C30DD-59B3-451B-9CB0-C15A78CC84EE}">
            <F N="main.cpp"/>
            <F N="MainWindow.cpp"/>
            <F N="RouteControlWidget.cpp"/>
            <F N="RouteScene.cpp"/>
            <F N="RouteSource.cpp"/>
            <F N="RouteWidget.cpp"/>
        </Folder>
        <Folder
            Name="Resource Files"
            Filters="*.ico;*.cur;*.dlg"
            GUID="{C6262C0D-FFF5-4FDF-A55A-21525CE3E9FB}"/>
        <Folder

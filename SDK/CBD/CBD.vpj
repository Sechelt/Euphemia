<!DOCTYPE Project SYSTEM "http://www.slickedit.com/dtd/vse/10.0/vpj.dtd">
<Project
    Version="10.0"
    VendorName="SlickEdit"
    TemplateName="(Other)"
    WorkingDir=".">
    <Config
        Name="Release"
        OutputFile=""
        CompilerConfigName="">
        <Menu>
            <Target
                Name="Compile"
                MenuCaption="&amp;Compile"
                CaptureOutputWith="ProcessBuffer"
                SaveOption="SaveCurrent"
                RunFromDir="%rw">
                <Exec/>
            </Target>
            <Target
                Name="Build"
                MenuCaption="&amp;Build"
                CaptureOutputWith="ProcessBuffer"
                SaveOption="SaveWorkspaceFiles"
                RunFromDir="%rw">
                <Exec CmdLine="make"/>
            </Target>
            <Target
                Name="Rebuild"
                MenuCaption="&amp;Rebuild"
                CaptureOutputWith="ProcessBuffer"
                SaveOption="SaveWorkspaceFiles"
                RunFromDir="%rw">
                <Exec/>
            </Target>
            <Target
                Name="Debug"
                MenuCaption="&amp;Debug"
                SaveOption="SaveNone"
                RunFromDir="%rw">
                <Exec/>
            </Target>
            <Target
                Name="Execute"
                MenuCaption="E&amp;xecute"
                SaveOption="SaveNone"
                RunFromDir="%rw">
                <Exec CmdLine='"CBD.exe"'/>
            </Target>
        </Menu>
    </Config>
    <Files>
        <Folder
            Name="Header Files"
            Filters="*.h;*.H;*.hh;*.hpp;*.hxx;*.h++;*.inc;*.sh;*.cpy;*.if"
            GUID="{745CA81C-C3BC-4B2D-89A2-D2AA57F254CC}">
            <F N="include/CBD.h"/>
            <F N="include/CBDMath.h"/>
            <F N="include/CBDPersist.h"/>
        </Folder>
        <Folder
            Name="Source Files"
            Filters="*.c;*.C;*.cc;*.cpp;*.cp;*.cxx;*.c++;*.prg;*.pas;*.dpr;*.asm;*.s;*.bas;*.java;*.cs;*.sc;*.scala;*.e;*.cob;*.html;*.rc;*.tcl;*.py;*.pl;*.d;*.m;*.mm;*.go;*.groovy;*.gsh"
            GUID="{6E28EC83-A959-4017-B335-656A50B19803}">
            <F N="source/CBD.cpp"/>
            <F N="source/CBDMath.cpp"/>
            <F N="source/CBDPersist.cpp"/>
            <F N="source/LibInfo.h"/>
        </Folder>
        <Folder
            Name="Resource Files"
            Filters="*.ico;*.cur;*.dlg"
            GUID="{D03F0409-B6A2-4DA0-A6D1-D155D448ADA0}"/>
        <Folder
            Name="Bitmaps"
            Filters="*.bmp"
            GUID="{4D2E1BB4-3C7C-4885-B0E7-D81C7FBA430D}"/>
        <Folder
            Name="Other Files"
            Filters=""
            GUID="{BD28821C-C568-48FA-9037-A81642E65118}">
            <F N="CBD.pro"/>
        </Folder>
    </Files>
    <List Name="RTE">
    </List>
</Project>

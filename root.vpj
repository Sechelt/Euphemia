<!DOCTYPE Project SYSTEM "http://www.slickedit.com/dtd/vse/10.0/vpj.dtd">
<Project
    Version="10.0"
    VendorName="SlickEdit"
    TemplateName="(Other)"
    WorkingDir=".">
    <Config
        Name="Release"
        OutputFile=""
        CompilerConfigName="">
        <Menu>
            <Target
                Name="Compile"
                MenuCaption="&amp;Compile"
                CaptureOutputWith="ProcessBuffer"
                SaveOption="SaveCurrent"
                RunFromDir="%rw">
                <Exec/>
            </Target>
            <Target
                Name="Build"
                MenuCaption="&amp;Build"
                CaptureOutputWith="ProcessBuffer"
                SaveOption="SaveWorkspaceFiles"
                RunFromDir="%rw">
                <Exec CmdLine="make"/>
            </Target>
            <Target
                Name="Rebuild"
                MenuCaption="&amp;Rebuild"
                CaptureOutputWith="ProcessBuffer"
                SaveOption="SaveWorkspaceFiles"
                RunFromDir="%rw">
                <Exec/>
            </Target>
            <Target
                Name="Debug"
                MenuCaption="&amp;Debug"
                SaveOption="SaveNone"
                RunFromDir="%rw">
                <Exec/>
            </Target>
            <Target
                Name="Execute"
                MenuCaption="E&amp;xecute"
                SaveOption="SaveNone"
                RunFromDir="%rw">
                <Exec CmdLine='"./bin/diagram"'/>
            </Target>
        </Menu>
    </Config>
    <Files>
        <Folder
            Name="Header Files"
            Filters="*.h;*.H;*.hh;*.hpp;*.hxx;*.h++;*.inc;*.sh;*.cpy;*.if"
            GUID="{1B079A6B-AD84-4A73-9058-DA9A4BD7CE2E}">
            <F N="Euphemia.h"/>
        </Folder>
        <Folder
            Name="Source Files"
            Filters="*.c;*.C;*.cc;*.cpp;*.cp;*.cxx;*.c++;*.prg;*.pas;*.dpr;*.asm;*.s;*.bas;*.java;*.cs;*.sc;*.scala;*.e;*.cob;*.html;*.rc;*.tcl;*.py;*.pl;*.d;*.m;*.mm;*.go;*.groovy;*.gsh"
            GUID="{E521374E-7C3D-4AB7-A4F0-D962577DF287}"></Folder>
        <Folder
            Name="Resource Files"
            Filters="*.ico;*.cur;*.dlg"
            GUID="{54EFA695-D68D-47E9-B9BE-FAED6AAF1F90}"/>
        <Folder
            Name="Bitmaps"
            Filters="*.bmp"
            GUID="{72AD392A-0BC7-4664-B742-65C90A932DD5}"/>
        <Folder
            Name="Other Files"
            Filters=""
            GUID="{EE965C74-A9B7-4B6A-BC90-ED5EB9FEA7AA}">
            <F N="BuildAll.sh"/>
            <F N="Clean.bat"/>
            <F N="common.pri"/>
            <F N="config.pri"/>
            <F N="CREDITS"/>
            <F N="defines.pri"/>
            <F N="Euphemia-1.0.spec"/>
            <F N="Euphemia.pri"/>
            <F N="Euphemia.pro"/>
            <F N="LICENSE"/>
            <F N="MakeTarBall.sh"/>
            <F N="odbc.pri"/>
            <F N="README.md"/>
            <F N="README.txt"/>
            <F N="sqlite.pri"/>
        </Folder>
    </Files>
    <List Name="RTE">
    </List>
</Project>
